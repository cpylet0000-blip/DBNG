
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# here is what's typically included in a .gitignore file for a Next.js project, but you can customize it based on your specific needs.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing the coverage directory is usually generated by testing tools like Jest or Cypress, and it contains reports about how much of your code is covered by tests. Since these reports can be large and are generated automatically, it's common to exclude them from version control.
/coverage
# admin fta
# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
